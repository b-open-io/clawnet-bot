# Optional: enables AI responses. Without this, /api/agent falls back to deterministic mode.
OPENAI_API_KEY=

# Optional model override
OPENAI_MODEL=gpt-4o-mini

# Optional ClawNet ingest endpoint for call telemetry
CLAWNET_EVENT_URL=
CLAWNET_EVENT_TOKEN=

# Injected by clawnet bot deploy
SIGMA_MEMBER_PRIVATE_KEY=
CLAWNET_MEMBER_BACKUP=
