{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"functions": {
		"api/**": {
			"runtime": "@vercel/bun@1"
		}
	},
	"rewrites": [{ "source": "/(.*)", "destination": "/api" }],
	"crons": [
		{ "path": "/api/heartbeat", "schedule": "*/5 * * * *" },
		{ "path": "/api/orchestrate", "schedule": "*/10 * * * *" }
	]
}
